{
  "info": {
    "name": "Acara 23 - Manual & Blackbox Testing (Mahasiswa + Auth)",
    "description": "Jalankan lewat Collection Runner, urut dari atas, dengan Environment Local. Token hanya berlaku 5 menit: jalankan seluruh koleksi dalam satu kali run, atau jalankan ulang TC04 bila token kedaluwarsa. Prasyarat: akun budi/rahasia123 sudah diregistrasi dan data NIM 220100123/456/789 belum ada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "TC04 Login kredensial benar (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Prasyarat: akun budi/rahasia123 sudah diregistrasi.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"budi\",\n    \"password\": \"rahasia123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test(\"Token diterima\", function () { pm.expect(j.data.token).to.be.a(\"string\"); });",
                  "pm.environment.set(\"token\", j.data.token);"
                ]
              }
            }
          ]
        },
