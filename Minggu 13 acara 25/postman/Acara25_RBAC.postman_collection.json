{
  "info": {
    "name": "Acara 25 - RBAC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register admin1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/register"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin1\",\n  \"email\": \"admin1@example.com\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Register budi (user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/register"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"budi\",\n  \"email\": \"budi@example.com\",\n  \"password\": \"rahasia123\"\n}"
            }
          }
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin1\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set('token_admin', j.data.token);",
                  "pm.test('role = admin', () => pm.expect(j.data.role).to.eql('admin'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"budi\",\n  \"password\": \"rahasia123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set('token_user', j.data.token);",
                  "pm.test('role = user', () => pm.expect(j.data.role).to.eql('user'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Uji RBAC",
      "item": [
        {
          "name": "GET mahasiswa tanpa token (publik)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/mahasiswa"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST mahasiswa tanpa token -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/mahasiswa"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"250100999\",\n  \"nama\": \"Mahasiswa Uji RBAC\",\n  \"email\": \"rbac@example.com\",\n  \"prodi_id\": 1,\n  \"angkatan\": 2025\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST mahasiswa token USER -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_user}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/mahasiswa"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"250100999\",\n  \"nama\": \"Mahasiswa Uji RBAC\",\n  \"email\": \"rbac@example.com\",\n  \"prodi_id\": 1,\n  \"angkatan\": 2025\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));",
                  "pm.test('pesan akses ditolak', () => pm.expect(pm.response.json().message).to.include('hanya admin'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT mahasiswa token USER -> 403",
          "request": {
            "method": "PUT",
            "header": [
